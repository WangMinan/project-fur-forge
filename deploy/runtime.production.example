OSS_PRIVATE_BUCKET=replace-private-bucket
OSS_PUBLIC_BUCKET=replace-public-bucket
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=replace-access-key-id
OSS_ACCESS_KEY_SECRET=replace-access-key-secret
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
