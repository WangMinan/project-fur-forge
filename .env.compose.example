# T34-F6 Compose 环境示例。复制为 .env 后填入真实值。
# 本文件不含任何真实 Secret，也不含真实域名。

# 已发布镜像（由 GitHub Actions 推送）。APP_IMAGE 不写死用户名。
APP_IMAGE=<your-dockerhub-username>/project-fur-forge
APP_IMAGE_TAG=latest

# Nginx 对外识别的两个 Host。当前没有正式域名，部署阶段填入实际域名。
PUBLIC_HOST=example.invalid
ADMIN_HOST=admin.example.invalid

# 正式 TLS 证书目录（挂载为只读 /etc/nginx/tls）。
# 本仓库不生成、不提交证书，也不做 ACME 自动化。
TLS_CERT_DIR=./deploy/nginx/tls
TLS_CERT_FILE=/etc/nginx/tls/fullchain.pem
TLS_KEY_FILE=/etc/nginx/tls/privkey.pem

# 应用地址，必须与上面两个 Host 一致（含协议）。
PUBLIC_BASE_URL=https://example.invalid
ADMIN_BASE_URL=https://admin.example.invalid
# 公开媒体 CDN / OSS 公开 Bucket 的对外地址。
MEDIA_BASE_URL=https://media.example.invalid
# 浏览器直传使用的 OSS 地址。
OSS_UPLOAD_BASE_URL=https://<private-bucket>.<oss-endpoint>

# 数据库固定落在持久卷内，一般不需要修改。
DATABASE_FILE=/app/data/studio.db

# 双 Bucket 配置。
OSS_REGION=
OSS_ENDPOINT=
OSS_PRIVATE_BUCKET=
OSS_PUBLIC_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 会话签名密钥：使用足够长的随机值，切勿复用示例值。
SESSION_SECRET=

# 可信代理网段（compose 内部网络）。留空表示不解析任何转发链，
# 此时一律使用直连地址，外部客户端无法伪造 X-Forwarded-For。
TRUSTED_PROXY_CIDRS=172.16.0.0/12
