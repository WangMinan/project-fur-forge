# T52-E6 · /etc/nginx/conf.d/ditedog.conf on root@120.26.51.205.
# Replace all three Host placeholders only after T53-F1 confirms the matching
# PUBLIC_BASE_URL, ADMIN_BASE_URL, and MEDIA_BASE_URL values.

upstream ditedog_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

# Unknown/wildcard hosts never fall through to Nitro.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 421;
}

# The ESA media Host belongs to ESA -> OSS and never reaches Nitro.
server {
    listen 80;
    listen [::]:80;
    server_name @@MEDIA_HOST@@;

    return 421;
}

server {
    listen 80;
    listen [::]:80;
    server_name @@PUBLIC_HOST@@ @@ADMIN_HOST@@;

    server_tokens off;
    client_max_body_size 32m;
    client_body_timeout 120s;

    proxy_http_version 1.1;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;
    proxy_connect_timeout 15s;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Cross-Origin-Opener-Policy same-origin always;

    # Health is checked locally; ESA/public clients do not receive it.
    location = /api/health {
        return 404;
    }

    location ^~ /api/health/ {
        return 404;
    }

    location / {
        proxy_pass http://ditedog_app;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port  443;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Only Nginx-generated failures enter the fallback; application errors pass through.
        proxy_intercept_errors off;
        proxy_hide_header X-Ditedog-Origin-Failure;
        error_page 502 503 504 = @backend_unavailable;
    }

    location @backend_unavailable {
        default_type text/plain;
        # Defining add_header here disables inheritance of the server-level headers.
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cache-Control no-store always;
        add_header Retry-After 60 always;
        add_header X-Ditedog-Origin-Failure backend-unavailable always;
        return 503 "Service temporarily unavailable\n";
    }
}
