# Optional active JSON configuration file. Relative paths resolve from the project root.
APP_CONFIG_FILE=

APP_ENV=
# Required outside tests. Put deployment-specific origins in .env; there is no built-in domain fallback.
PUBLIC_BASE_URL=
ADMIN_BASE_URL=
# Production: stable ESA media origin, exactly https://public-media.ditedog.com.
# Do not use an OSS Bucket domain.
MEDIA_BASE_URL=
# Browser upload origin: the private Bucket public Hangzhou domain. Never use an -internal host here.
OSS_UPLOAD_BASE_URL=
DATABASE_FILE=

OSS_REGION=
OSS_PRIVATE_BUCKET=
OSS_PUBLIC_BUCKET=
# Server-side SDK endpoint. Local development uses https://oss-cn-hangzhou.aliyuncs.com;
# a production ECS instance in Hangzhou uses https://oss-cn-hangzhou-internal.aliyuncs.com.
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ESA cache purge uses a separate least-privilege RAM identity.
# These values are server-only and are not the ESA-to-OSS managed STS flow.
ESA_SITE_ID=
ESA_ACCESS_KEY_ID=
ESA_ACCESS_KEY_SECRET=

SESSION_SECRET=
ICP_FILING_NUMBER=
ICP_FILING_URL=
# unconfigured | not_applicable | filed。filed 时必须同时填写公安备案号和
# https://beian.mps.gov.cn/ 官方链接。
POLICE_FILING_STATUS=
POLICE_FILING_NUMBER=
POLICE_FILING_URL=
# T34-F5 可信代理网段（逗号分隔 CIDR）。留空表示不解析任何 X-Forwarded-For，
# 一律使用直连地址，外部客户端因此无法伪造来源。
TRUSTED_PROXY_CIDRS=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
