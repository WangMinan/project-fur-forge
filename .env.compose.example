# T34-F6 Docker Compose 环境示例。
# 复制为 .env 后替换全部 replace-me 值；本文件不含真实 Secret 或正式域名。

# GitHub Actions 发布到 Docker Hub 的应用镜像。
APP_IMAGE=example/project-fur-forge
APP_IMAGE_TAG=latest

# Nginx 识别的公开与管理 Host。
PUBLIC_HOST=public.example.test
ADMIN_HOST=admin.example.test

# 正式 TLS 证书目录和容器内路径。
TLS_CERT_DIR=./deploy/nginx/tls
TLS_CERT_FILE=/etc/nginx/tls/fullchain.pem
TLS_KEY_FILE=/etc/nginx/tls/privkey.pem

PUBLIC_BASE_URL=https://public.example.test
ADMIN_BASE_URL=https://admin.example.test
MEDIA_BASE_URL=https://media.example.test
OSS_UPLOAD_BASE_URL=https://replace-me-private.oss-cn-hangzhou.aliyuncs.com

DATABASE_FILE=/app/data/studio.db

OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_PRIVATE_BUCKET=replace-me-private
OSS_PUBLIC_BUCKET=replace-me-public
OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me

# 使用密码管理器生成足够长的随朹吼。
SESSION_SECRET=replace-with-a-long-random-session-secret

# backend 网络使用固定小网段，应用只信任该网段内 Nginx 写入的转发头。
# 如部署机器发生网段冲突，应同时修改这两个值并保持一致。
BACKEND_SUBNET=172.30.250.0/24
TRUSTED_PROXY_CIDRS=172.30.250.0/24
