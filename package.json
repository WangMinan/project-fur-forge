{
  "name": "project-fur-paws",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.33 <11"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && node scripts/guard-production-content.mjs .output",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint app server shared scripts tests nuxt.config.ts vitest.config.ts vitest.integration.config.ts playwright.config.ts eslint.config.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "verify:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "nuxt": "4.5.1",
    "vue": "3.5.40",
    "vue-router": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.16.0",
    "@nuxt/test-utils": "4.1.0",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  }
}
