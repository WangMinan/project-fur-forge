# Optional active JSON configuration file. Relative paths resolve from the project root.
APP_CONFIG_FILE=

APP_ENV=
# Required outside tests. Put deployment-specific origins in .env; there is no built-in domain fallback.
PUBLIC_BASE_URL=
ADMIN_BASE_URL=
# Stable ESA media origin. Production must use an ESA custom domain, not an OSS Bucket domain.
MEDIA_BASE_URL=
# Browser upload origin: the private Bucket public Hangzhou domain. Never use an -internal host here.
OSS_UPLOAD_BASE_URL=
DATABASE_FILE=

OSS_REGION=
OSS_PRIVATE_BUCKET=
OSS_PUBLIC_BUCKET=
# Server-side SDK endpoint. Local development uses https://oss-cn-hangzhou.aliyuncs.com;
# a production ECS instance in Hangzhou uses https://oss-cn-hangzhou-internal.aliyuncs.com.
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ESA purge reuses OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET.
# ESA-to-OSS managed STS is still handled by Aliyun and is unrelated.
ESA_SITE_ID=
ESA_API_ENDPOINT=

SESSION_SECRET=
ICP_FILING_NUMBER=浙ICP备2026062899号
ICP_FILING_URL="https://beian.miit.gov.cn/#/Integrated/index"
# unconfigured | not_applicable | filed。filed 时必须同时填写公安备案号和
# https://beian.mps.gov.cn/ 官方链接。
POLICE_FILING_STATUS=filed
POLICE_FILING_NUMBER=浙公网安备33010202006082号
POLICE_FILING_URL="https://beian.mps.gov.cn/#/query/webSearch?code=33010202006082"
# 可信代理网段（逗号分隔 CIDR）。开发/测试可留空；生产必须包含固定 Compose
# gateway 172.30.250.1/32 和 T53-F2 当日确认的全部 ESA 代理 CIDR，否则启动失败。
TRUSTED_PROXY_CIDRS=
