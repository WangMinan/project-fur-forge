# T34-F6 Nginx 双 Host 模板。
#
# 不硬编码任何域名：PUBLIC_HOST / ADMIN_HOST 由 compose 环境变量注入，
# 官方 nginx 镜像启动时对本文件执行 envsubst。
# 正式证书路径同样可配置；本仓库不生成、不提交证书，也不做 ACME 自动化。

upstream app_upstream {
    server app:3000;
    keepalive 32;
}

# 未知 Host 明确拒绝，不回落到公开站。
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     ${TLS_CERT_FILE};
    ssl_certificate_key ${TLS_KEY_FILE};

    return 421;
}

# HTTP 一律跳转 HTTPS（只对已知 Host）。
server {
    listen 80;
    server_name ${PUBLIC_HOST} ${ADMIN_HOST};
    return 308 https://$host$request_uri;
}

map $host $fur_forge_is_admin {
    default            0;
    ${ADMIN_HOST}      1;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_HOST} ${ADMIN_HOST};

    ssl_certificate     ${TLS_CERT_FILE};
    ssl_certificate_key ${TLS_KEY_FILE};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # 与 30 MB 原图上传策略一致（留出分片与头部余量）。
    client_max_body_size 32m;
    client_body_timeout  120s;

    proxy_http_version 1.1;
    proxy_read_timeout    180s;
    proxy_send_timeout    180s;
    proxy_connect_timeout 15s;

    # 安全头。HSTS 只在正式域名与证书就位后启用。
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Cross-Origin-Opener-Policy same-origin always;

    location / {
        proxy_pass http://app_upstream;

        # 保留原始 Host：应用按 Host 区分公开面与管理面。
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # WebSocket / 流式连接正确转发。
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # 管理端响应绝不进入任何共享缓存，避免被当作公开内容复用。
        proxy_no_cache     $fur_forge_is_admin;
        proxy_cache_bypass $fur_forge_is_admin;
    }

    # 健康检查不对外公开。
    location /api/health/ {
        deny all;
        return 404;
    }
}
